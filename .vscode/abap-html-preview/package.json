{
  "name": "abap-html-preview",
  "displayName": "ABAP HTML 브라우저 화면",
  "description": "수정본 폴더의 ABAP HTML 코드 목록을 브라우저와 같은 화면으로 엽니다.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.71.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:local.abapHtmlPreview"
  ],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "local.abapHtmlPreview",
        "displayName": "브라우저 화면",
        "selector": [
          {
            "filenamePattern": "*.html"
          }
        ],
        "priority": "option"
      }
    ]
  }
}
